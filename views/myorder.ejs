<%- include ('./navbar1.ejs') %>


  <title>My Order | Fika</title>
  <meta name="description" content="My Order |  Fika">
  <!-- Orders content -->
  <div class="col-lg-9">
    <div class="ps-lg-3 ps-xl-0">

      <!-- Page title + Sorting selects -->
      <div class="row align-items-center pb-3 pb-md-4 mb-md-1 mb-lg-2">
        <div class="col-md-6 col-xl-6">
          <h1 class="h2 mb-0">Orders</h1>
        </div>
        <div class="col-md-6 col-xl-6 text-md-end text-start mt-3 mt-md-0">
          <a href="https://forms.gle/ZnXbjBRR6XwgCiWSA" class="btn btn-primary btn-lg shadow-sm">
            Claim Product Warranty
          </a>
        </div>
      </div>
      <style>
        /* ===== TABLE BASE ===== */
        .orders-table {
          width: 100%;
          table-layout: fixed;
          border-collapse: separate;
          border-spacing: 0;
          background: #fff;
          border: 1px solid #e5e7eb;
          border-radius: 10px;
          overflow: hidden;
        }

        /* ===== HEADER ===== */
        .orders-table thead th {
          background: #f8fafc;
          font-weight: 600;
          font-size: 14px;
          padding: 14px;
          border-bottom: 1px solid #e5e7eb;
          text-align: left;
          white-space: nowrap;
        }

        /* ===== BODY ===== */
        .orders-table tbody td {
          padding: 14px;
          font-size: 14px;
          vertical-align: middle;
          border-bottom: 1px solid #f1f5f9;
          word-break: break-word;
        }

        .orders-table tbody tr:last-child td {
          border-bottom: none;
        }

        .orders-table tbody tr:hover {
          background: #f9fafb;
        }

        /* ===== PRODUCT CELL ===== */
        .product-cell {
          display: flex;
          align-items: center;
          gap: 12px;
        }

        .product-cell img {
          width: 60px;
          height: 60px;
          object-fit: cover;
          border-radius: 8px;
          border: 1px solid #e5e7eb;
          flex-shrink: 0;
        }

        .product-cell>div {
          min-width: 0;
        }

        .product-title {
          font-weight: 500;
          line-height: 1.4;
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
          max-width: 220px;
        }

        /* ===== STATUS BADGE ===== */
        .status-badge {
          font-size: 12px;
          padding: 5px 12px;
          border-radius: 20px;
          background: #e0f2fe;
          color: #0369a1;
          font-weight: 500;
        }

        /* ===== ACTION BUTTON ===== */
        .orders-table .btn {
          padding: 4px 10px;
          font-size: 13px;
        }

        /* ===== MOBILE VIEW ===== */
        @media (max-width: 768px) {
          .orders-table thead {
            display: none;
          }

          .orders-table,
          .orders-table tbody,
          .orders-table tr,
          .orders-table td {
            display: block;
            width: 100%;
          }

          .orders-table tr {
            margin-bottom: 15px;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 10px;
            background: #fff;
          }

          .orders-table td {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border: none;
          }

          .orders-table td::before {
            content: attr(data-label);
            font-weight: 600;
            color: #475569;
          }

          .product-title {
            max-width: 100%;
            white-space: normal;
          }
        }
      </style>



      <!-- Sortable orders table -->
      <div data-filter-list='{"listClass": "orders-list", "sortClass": "orders-sort", "valueNames": ["date", "total"]}'>
        <table class="table orders-table">
          <thead>
            <tr>
              <th>Order ID</th>
              <th>Product</th>
              <th>Product</th>
              <th>Quantity</th>
              <th>Order Date</th>
              <th>Status</th>
              <th>Payment</th>
              <th>Total</th>
              <th>Action</th>
            </tr>
          </thead>

          <tbody class="orders-list">
            <% for(let order of result[1]) { %>
              <tr>
                <td data-label="Order ID">
                  <a href="/invoice?orderid=<%=order.orderid%>">
                    <%=order.orderid%>
                  </a>
                </td>

                <td data-label="Product">
                  <div class="product-cell">
                    <img src="/images/<%=order.bookingimage%>" alt="">
                  </div>
                </td>
                <td data-label="Product">
                  <div class="product-cell">
                    <div>
                      <div class="product-title" title="<%= order.bookingname %>">
                        <%= order.bookingname.length> 30
                          ? order.bookingname.substring(0, 30) + '...'
                          : order.bookingname
                          %>
                      </div>
                    </div>
                  </div>
                </td>

                <td data-label="Order Date">
                  Qty: <%=order.quantity%>
                </td>

                <td data-label="Order Date">
                  <%=order.order_date%>
                </td>

                <td data-label="Status">
                  <span class="status-badge">
                    <%=order.status.toUpperCase()%>
                  </span>
                </td>

                <td data-label="Payment">
                  <%=order.payment_mode%>
                </td>

                <td data-label="Total">
                  ₹ <%=order.price%>
                </td>

                <td data-label="Action">
                  <button class="btn btn-sm btn-outline-primary" data-bs-toggle="offcanvas"
                    data-orderid="<%=order.orderid%>" data-productid="<%=order.booking_id%>"
                    data-status="<%=order.status.toUpperCase()%>" data-image="<%=order.bookingimage%>"
                    data-name="<%=order.bookingname%>" data-price="<%=order.price%>" data-quantity="<%=order.quantity%>"
                    data-shippingaddress="<%=order.address%>" data-paymentmethod="<%=order.payment_mode%>"
                    data-originalid="<%=order.id%>" data-total="<%=order.price%>">
                    View
                  </button>

                  <% if(order.status==='Dispatched' ){ %>
                    <br>
                    <a href="<%=order.awb%>" target="_blank">Track</a>
                    <% } %>
                </td>
              </tr>
              <% } %>
          </tbody>
        </table>
      </div>

    </div>
  </div>
  </div>
  </div>
  </main>


  <!-- Sidebar navigation offcanvas toggle that is visible on screens < 992px wide (lg breakpoint) -->
  <button type="button"
    class="fixed-bottom z-sticky w-100 btn btn-lg btn-dark border-0 border-top border-light border-opacity-10 rounded-0 pb-4 d-lg-none"
    data-bs-toggle="offcanvas" data-bs-target="#accountSidebar" aria-controls="accountSidebar" data-bs-theme="light">
    <i class="ci-sidebar fs-base me-2"></i>
    Account menu
  </button>


  <!-- Back to top button -->
  <div class="floating-buttons position-fixed top-50 end-0 z-sticky me-3 me-xl-4 pb-4">
    <a class="btn-scroll-top btn btn-sm bg-body border-0 rounded-pill shadow animate-slide-end" href="#top">
      Top
      <i class="ci-arrow-right fs-base ms-1 me-n1 animate-target"></i>
      <span class="position-absolute top-0 start-0 w-100 h-100 border rounded-pill z-0"></span>
      <svg class="position-absolute top-0 start-0 w-100 h-100 z-1" viewBox="0 0 62 32" fill="none"
        xmlns="http://www.w3.org/2000/svg">
        <rect x=".75" y=".75" width="60.5" height="30.5" rx="15.25" stroke="currentColor" stroke-width="1.5"
          stroke-miterlimit="10"></rect>
      </svg>
    </a>

  </div>


  <!-- Vendor scripts -->
  <script src="/theme/assets/vendor/choices.js/choices.min.js"></script>
  <script src="/theme/assets/vendor/list.js/list.min.js"></script>

  <!-- Bootstrap + Theme scripts -->
  <script src="/theme/assets/js/theme.min.js"></script>


