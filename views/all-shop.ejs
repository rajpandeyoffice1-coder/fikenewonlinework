<%- include('./navbar.ejs') %>

  <title>
    <%= result[2][0]?.name || 'Products' %> | Fika
  </title>

  <style>
    body {
      background: #f6f7f8
    }

    .filter-drawer {
      position: fixed;
      top: 0;
      left: 0;
      width: 300px;
      height: 100%;
      background: #fff;
      z-index: 1055;
      transform: translateX(-100%);
      transition: .35s ease;
      box-shadow: 4px 0 18px rgba(0, 0, 0, .12);
      display: flex;
      flex-direction: column
    }

    .filter-drawer.active {
      transform: translateX(0)
    }

    .filter-header {
      padding: 16px;
      font-weight: 700;
      border-bottom: 1px solid #eee;
      display: flex;
      justify-content: space-between;
      align-items: center
    }

    .filter-body {
      padding: 16px;
      overflow: auto
    }

    .filter-footer {
      padding: 12px;
      border-top: 1px solid #eee
    }

    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, .4);
      z-index: 1050;
      display: none
    }

    .overlay.show {
      display: block
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px
    }

    @media(max-width:1200px) {
      .product-grid {
        grid-template-columns: repeat(3, 1fr)
      }
    }

    @media(max-width:768px) {
      .product-grid {
        grid-template-columns: repeat(2, 1fr)
      }
    }

    .product-card {
      background: #fff;
      border-radius: 16px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: 0 2px 8px rgba(0, 0, 0, .06)
    }

    .product-card img {
      width: 100%;
      height: 160px;
      object-fit: contain
    }

    .badge {
      background: #ffc107;
      font-size: 12px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 10px;
      display: inline-block
    }

    .rating {
      font-size: 13px;
      margin: 6px 0
    }

    .price {
      font-size: 18px;
      font-weight: 700
    }

    .cart-btn {
      background: #111;
      color: #fff;
      border: none;
      padding: 10px;
      border-radius: 12px;
      width: 100%
    }

    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px
    }
  </style>

  <main class="container py-3">

    <div class="top-bar">
      <button class="btn btn-light" onclick="openFilter()">☰ Filter</button>
      <select id="sortSelect" class="form-select form-select-sm" style="width:180px">
        <option value="popularity">Featured</option>
        <option value="low">Price: Low to High</option>
        <option value="high">Price: High to Low</option>
      </select>
    </div>

    <div id="productGrid" class="product-grid">

      <% result[1].forEach(p=>{ %>
        <div class="product-item" data-brand="<%=p.brand%>" data-price="<%=p.net_amount%>"
          data-rating="<%=p.rating||4%>" data-features="<%=p.features||''%>">

          <div class="product-card">
            <a href="/product?id=<%=p.id%>">
              <img src="/images/<%=p.image%>">
            </a>

            <div class="badge">
              <%=p.features?p.features.split(',')[0]:'High Playback'%>
            </div>

            <a href="/product?id=<%=p.id%>" style="text-decoration: none; color: black;">
              <div style="font-weight:600;font-size:14px;line-height:1.3;margin-top: 12px;margin-bottom: 12px;">
                <%= p.name.replace(/"/g,'').length> 60
                  ? p.name.replace(/"/g,'').substring(0,60) + '...'
                  : p.name.replace(/"/g,'') %>
              </div>
            </a>

            <!-- <div class="rating">⭐ <%=p.rating||4.8%></div> -->

            <div class="price mb-2">₹<%=p.net_amount%>
            </div>

            <button class="cart-btn" onclick="addToCart('<%=p.id%>')">
              Add To Cart
            </button>
          </div>
        </div>
        <% }) %>

    </div>
  </main>

  <div id="overlay" class="overlay" onclick="closeFilter()"></div>

  <div id="filterDrawer" class="filter-drawer">
    <div class="filter-header">
      Filters
      <button class="btn-close" onclick="closeFilter()"></button>
    </div>

    <div class="filter-body">

      <h6>Brand</h6>
      <div><input type="checkbox" class="brand-filter" value="boAt"> boAt</div>
      <div><input type="checkbox" class="brand-filter" value="JBL"> JBL</div>
      <div><input type="checkbox" class="brand-filter" value="Sony"> Sony</div>

      <hr>

      <h6>Max Price</h6>
      <input type="range" id="priceRange" min="0" max="5000" value="5000">
      ₹0 – ₹<span id="priceValue">5000</span>

      <hr>

      <h6>Features</h6>
      <div><input type="checkbox" class="feature-filter" value="Wireless"> Wireless</div>
      <div><input type="checkbox" class="feature-filter" value="Noise"> Noise Cancellation</div>

      <hr>

      <h6>Rating</h6>
      <div><input type="radio" name="rating" class="rating-filter" value="4"> 4★ & up</div>
      <div><input type="radio" name="rating" class="rating-filter" value="3"> 3★ & up</div>
      <div><input type="radio" name="rating" class="rating-filter" value="0" checked> All</div>

    </div>

    <div class="filter-footer">
      <button class="btn btn-dark w-100" onclick="applyFilters()">Apply Filters</button>
    </div>
  </div>

  <script>
    const drawer = document.getElementById('filterDrawer')
    const overlay = document.getElementById('overlay')
    const products = [...document.querySelectorAll('.product-item')]
    const sortSelect = document.getElementById('sortSelect')

    function openFilter() { drawer.classList.add('active'); overlay.classList.add('show') }
    function closeFilter() { drawer.classList.remove('active'); overlay.classList.remove('show') }

    function applyFilters() {
      filterProducts(); sortProducts(); closeFilter()
    }

    function filterProducts() {
      const brands = [...document.querySelectorAll('.brand-filter:checked')].map(b => b.value)
      const features = [...document.querySelectorAll('.feature-filter:checked')].map(f => f.value)
      const rating = document.querySelector('.rating-filter:checked').value
      const maxPrice = document.getElementById('priceRange').value

      products.forEach(p => {
        const show =
          (!brands.length || brands.includes(p.dataset.brand)) &&
          (+p.dataset.price <= maxPrice) &&
          (+p.dataset.rating >= rating) &&
          (!features.length || features.every(f => p.dataset.features.includes(f)))
        p.style.display = show ? '' : 'none'
      })
    }

    function sortProducts() {
      const grid = document.getElementById('productGrid')
      const items = products.filter(p => p.style.display !== 'none')
      items.sort((a, b) =>
        sortSelect.value === 'low' ? a.dataset.price - b.dataset.price :
          sortSelect.value === 'high' ? b.dataset.price - a.dataset.price : 0
      )
      items.forEach(i => grid.appendChild(i))
    }

    document.getElementById('priceRange').addEventListener('input', e => {
      document.getElementById('priceValue').textContent = e.target.value
      filterProducts()
    })
    sortSelect.addEventListener('change', sortProducts)
  </script>

  <%- include('./footer.ejs') %>
    <%- include('./footer1.ejs') %>